<Page x:Class="SnakeWPF.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SnakeWPF.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/SnakeWPF;component/Image/menu-background.png"/>
        </Grid.Background>
        <Grid>
            <Grid Width="320" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Background>
                    <ImageBrush ImageSource="/SnakeWPF;component/Image/space-for-buttons-background.png"/>
                </Grid.Background>

                <Label
                    Content="Your IP address:"
                    HorizontalAlignment="Left"
                    Margin="58,49,0,0"
                    VerticalAlignment="Top"
                    Foreground="Black"
                    FontFamily="Forte"/>
                <Label
                    Content="Port:"
                    HorizontalAlignment="Left"
                    Margin="202,49,0,0"
                    VerticalAlignment="Top"
                    Foreground="Black"
                    Width="74"
                    FontFamily="Forte"/>
                <Label
                    Content="Your Name:"
                    HorizontalAlignment="Left"
                    Margin="58,96,0,0"
                    VerticalAlignment="Top"
                    Foreground="Black"
                    FontFamily="Forte"/>
                <TextBox x:Name="ip"
                         HorizontalAlignment="Left"
                         Height="20"
                         Margin="58,71,0,0"
                         TextWrapping="Wrap"
                         Text="192.168.0.107"
                         VerticalAlignment="Top"
                         Width="140"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         FontFamily="Forte"/>
                <TextBox x:Name="port"
                         HorizontalAlignment="Left"
                         Height="20"
                         Margin="202,71,0,0"
                         TextWrapping="Wrap"
                         Text="5000"
                         VerticalAlignment="Top"
                         Width="65"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         FontFamily="Forte"/>
                <TextBox x:Name="name"
                         HorizontalAlignment="Left"
                         Height="20"
                         Margin="58,118,0,0"
                         TextWrapping="Wrap"
                         Text="Alexashchka"
                         VerticalAlignment="Top"
                         Width="204"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         FontFamily="Forte"/>
                <Button Click="StartGame"
                        Content="Game"
                        HorizontalAlignment="Left"
                        Margin="58,148,0,0"
                        VerticalAlignment="Top"
                        Width="204"
                        Height="20"
                        FontFamily="Forte"/>
            </Grid>

        </Grid>
    </Grid>
</Page>
